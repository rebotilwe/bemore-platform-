# ============================================================
# BeMore Backend — Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.
#   cp .env.example .env
# ============================================================

# ── Server ───────────────────────────────────────────────────
PORT=5000
NODE_ENV=development                # development | staging | production

# ── Database ─────────────────────────────────────────────────
# REQUIRED in production/staging — app will exit if missing.
MONGODB_URI=mongodb://localhost:27017/bemore

# ── Authentication ───────────────────────────────────────────
# REQUIRED in production/staging — app will exit if missing.
# Use a strong random string of 32+ characters.
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=8h                   # Token lifetime (e.g. 8h, 1d)

# ── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000         # Window in ms (default 15 min)
RATE_LIMIT_MAX_REQUESTS=100         # Max requests per window

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated origins, or leave blank/* to use built-in defaults.
# Defaults: dev → localhost:5173/3000 + prod + staging origins
#           staging → staging + bemorecapital.co.za origins
#           production → bemore-tawny.vercel.app + bemorecapital.co.za
CORS_ORIGIN=

# ── Email: Resend (sole provider — SMTP removed 2026-05-11) ──
# REQUIRED in production/staging. All transactional email is sent through
# Resend. Get a key at https://resend.com → API Keys.
RESEND_API_KEY=

# Sender identity. Default `onboarding@resend.dev` works for any Resend
# account but can only deliver to the API key owner's email — use a verified
# domain (e.g. info@bts-app.co.za) for real traffic.
EMAIL_FROM=onboarding@resend.dev
EMAIL_FROM_NAME=BeMore

# ── Platform URL ─────────────────────────────────────────────
# Used in email templates for links back to the platform.
PLATFORM_URL=https://bemore-tawny.vercel.app

# ── File Uploads ─────────────────────────────────────────────
# CV uploads (Built Environment Professional flow) — spec §8.1.
# Local dev default: ./uploads (relative to backend cwd).
# Railway production: set to /app/uploads (persistent volume mount).
UPLOAD_DIR=./uploads

# ── Admin Seed Account ───────────────────────────────────────
# First admin user created on startup if no admins exist.
ADMIN_SEED_EMAIL=admin@bemore.co.za
ADMIN_SEED_PASSWORD=
